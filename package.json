{
  "name": "medium_dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint || true",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:generate": "prisma generate",
    "db:push": "npx prisma db push",
    "seed": "ts-node --project tsconfig.json scripts/seed.ts",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "dev:docker": "docker-compose up --build",
    "docker:seed": "pnpm prisma:generate && pnpm run seed",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --runInBand --coverage",
    "smoke:test": "bash scripts/smoke-test.sh",
    "prepare": "node -e \"const fs=require('fs'); if(!fs.existsSync('.husky')) require('child_process').execSync('husky install', {stdio:'inherit'})\""
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^2.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.2",
    "@jest/types": "^29.7.0",
    "@types/node": "^20.5.1",
    "@types/react": "^18.2.21",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.0.0",
    "postcss": "^8.0.0",
    "prettier": "^2.0.0",
    "prisma": "^5.0.0",
    "tailwindcss": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
